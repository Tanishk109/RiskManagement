# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Python
/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
/merchantshield.db

# IEEE-CIS protected/local data
/data/raw/
/data/processed/
/data/cache/
/data/**/*.csv
/data/**/*.parquet
/data/**/*.pkl
/data/**/*.feather
/.kaggle/
kaggle.json

# Local model bundles and prediction rows
/artifacts/models/*.joblib
/artifacts/models/*.cbm
/artifacts/predictions/
/artifacts/metrics/*predictions*.csv
/artifacts/metrics/*cases*.csv

# Local benchmark/runtime outputs
/artifacts/metrics/inference_benchmark.json
