# PostgreSQL used by the FastAPI service. Replace with a Neon/Supabase URL in deployment.
# Supported schemes: postgres://, postgresql://, postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://merchantshield:merchantshield@localhost:5432/merchantshield

# Browser-facing API origin for local Next.js development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Local-only artifacts generated from the IEEE-CIS pipeline
MODEL_PATH=./artifacts/models/model.joblib
MODEL_METADATA_PATH=./artifacts/models/model_metadata.json
METRICS_PATH=./artifacts/metrics/final_test_metrics.json
PREDICTIONS_PATH=./artifacts/metrics/final_test_predictions.csv
RULES_PATH=./rules/merchant_rules.yaml

ENVIRONMENT=development
