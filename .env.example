# PostgreSQL used by the FastAPI service. Replace with a Neon/Supabase URL in deployment.
# Supported schemes: postgres://, postgresql://, postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://merchantshield:merchantshield@localhost:5432/merchantshield

# Browser-facing API origin for local Next.js development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Local-only artifacts generated from the IEEE-CIS pipeline
MODEL_PATH=./artifacts/models/model.joblib
MODEL_METADATA_PATH=./artifacts/models/model_metadata.json
METRICS_PATH=./artifacts/metrics/final_test_metrics.json
PREDICTIONS_PATH=./artifacts/metrics/final_test_predictions.csv
RULES_PATH=./rules/merchant_rules.yaml
EDA_SUMMARY_PATH=./artifacts/reports/eda_summary.json
SPLIT_METADATA_PATH=./data/processed/ieee-cis/split_metadata.json
BASELINE_METRICS_PATH=./artifacts/metrics/baseline_validation.json
CATBOOST_METRICS_PATH=./artifacts/metrics/catboost_validation.json
CATBOOST_METADATA_PATH=./artifacts/models/catboost_candidate_metadata.json
EXPERIMENTS_PATH=./artifacts/metrics/experiments.csv
FEATURE_IMPORTANCE_PATH=./artifacts/reports/catboost_feature_importance.csv
BASELINE_VALIDATION_PREDICTIONS_PATH=./artifacts/predictions/baseline_validation.parquet
CATBOOST_VALIDATION_PREDICTIONS_PATH=./artifacts/predictions/catboost_identity_ablation_validation.parquet
VALIDATION_DATA_PATH=./data/processed/ieee-cis/validation.parquet
THRESHOLD_ANALYSIS_PATH=./artifacts/metrics/threshold_analysis.json

ENVIRONMENT=development
